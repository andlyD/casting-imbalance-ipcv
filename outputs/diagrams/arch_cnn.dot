digraph A {
  rankdir=LR; dpi=220; nodesep=0.2; ranksep=0.22;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, fillcolor="#F2F2F2", color="#555555", margin="0.06,0.05", width=1.3, height=0.9];
  edge [color="#555555", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#555555"];
  subgraph cluster_b { label="(b) CNN trained from scratch\l240,737 trained parameters\l"; labeljust=l; fontname="Helvetica-Bold"; fontsize=12; color="#0072B2"; style=rounded;
    b0 [label="Grayscale\n128 × 128\nGaussian\n3 × 3", fillcolor="#DCEAF7"];
    b1 [label="Rescale to\n[0, 1]\nrandom flip,\nrotation, shift,\ncontrast\n(training only)"];
    b2 [label="4 conv blocks\n3 × 3 filters\n32, 64, 128, 128\nbatch norm\nReLU\nmax pool 2 × 2\n→ 8 × 8 × 128"];
    b3 [label="Global average\npooling\n128 values\nDropout 0.4"];
    b4 [label="Dense 1\nsigmoid\nP(Defective)", fillcolor="#E2F0D9"];
    b0->b1->b2->b3->b4; }
}
